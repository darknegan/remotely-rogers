{
  "name": "remotely-rogers",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "export:lodgify-snippets": "node tools/export-lodgify-snippets.mjs",
    "build:booking-worker": "ng build --configuration=booking-worker && node tools/prepare-booking-worker-assets.mjs",
    "deploy:booking-worker": "npm run build:booking-worker && wrangler deploy"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.17",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.17",
    "@primeuix/themes": "^2.0.3",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sass": "^1.89.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.120.0"
  }
