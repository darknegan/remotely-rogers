{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remotely-rogers-booking",
  "main": "workers/booking-calendar/src/index.ts",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./dist/remotely-rogers/browser",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "BOOKING_STATE",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000001"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKING_COORDINATOR",
        "class_name": "BookingCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-booking-coordinator",
      "new_classes": ["BookingCoordinator"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
