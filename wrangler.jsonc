{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remotely-rogers-booking",
  "main": "workers/booking-calendar/src/index.ts",
  "compatibility_date": "2026-08-07",
  "vars": {
    "AIRBNB_LISTING_MAP": "{\"1\":\"1522512039110168394\",\"2\":\"1547465342213988673\",\"3\":\"1515997598220048670\",\"4\":\"1511108076176473313\",\"5\":\"1509551118415599833\",\"6\":\"1497757944361518833\"}"
  },
  "assets": {
    "directory": "./dist/remotely-rogers/browser",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "BOOKING_STATE",
      "id": "57d85ac3dce6486f8858f9ae327c9152"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKING_COORDINATOR",
        "class_name": "BookingCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-booking-coordinator-sqlite",
      "new_sqlite_classes": ["BookingCoordinator"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
