# Bookingmood Public API key — never commit the real value.
BOOKINGMOOD_API_KEY=

# JSON map site cabin id → Bookingmood product UUID (see cabin-config.ts ids 1–6).
BOOKINGMOOD_PRODUCT_MAP=

BOOKINGMOOD_CAPACITY_GROUP_ID=

# JSON guest field → Bookingmood form service id.
BOOKINGMOOD_FORM_SERVICES=

BOOKINGMOOD_WEBHOOK_SIGNING_SECRET=

# Explicit gate for checkout writes (set true only when mapping + services verified).
BOOKINGMOOD_BOOKING_ENABLED=false

# Temporary Airbnb availability preview (see docs/bookingmood/README.md). true overrides Bookingmood
# availability and keeps checkout off.
AIRBNB_PREVIEW_ENABLED=false
AIRBNB_LISTING_MAP={"1":"1522512039110168394","2":"1547465342213988673","3":"1515997598220048670","4":"1511108076176473313","5":"1509551118415599833","6":"1497757944361518833"}
# Airbnb's public web API key (from airbnb.com page HTML) — keep out of git.
AIRBNB_WEB_API_KEY=
# Optional upstream override, e.g. https://www.airbnb.com/api/v3/PdpAvailabilityCalendar/<hash>
AIRBNB_PREVIEW_UPSTREAM=

# Worker bindings (create in Cloudflare dashboard — do not commit ids from production):
# BOOKING_STATE — KV namespace for webhook dedupe + public booking reference status
# BOOKING_COORDINATOR — Durable Object class BookingCoordinator for checkout idempotency

CLOUDFLARE_API_TOKEN=
