# Bookingmood Public API key — never commit the real value.
# Production: npx wrangler secret put BOOKINGMOOD_API_KEY
BOOKINGMOOD_API_KEY=

# JSON map site cabin id → Bookingmood product UUID (see cabin-config.ts ids 1–6).
# Production: npx wrangler secret put BOOKINGMOOD_PRODUCT_MAP
BOOKINGMOOD_PRODUCT_MAP=

# Capacity group UUID used as occupancy map key in cart-validate / cart-checkout.
BOOKINGMOOD_CAPACITY_GROUP_ID=

# JSON guest field → Bookingmood form service id, e.g.
# {"firstName":"…","lastName":"…","email":"…","phone":"…","notes":"…"}
BOOKINGMOOD_FORM_SERVICES=

# Webhook signing secret (Standard Webhooks). Production: wrangler secret put BOOKINGMOOD_WEBHOOK_SIGNING_SECRET
BOOKINGMOOD_WEBHOOK_SIGNING_SECRET=

# Explicit gate for checkout writes (set true only when mapping + services verified).
BOOKINGMOOD_BOOKING_ENABLED=false

# Cloudflare API token for Wrangler (account auth, not a Worker binding).
CLOUDFLARE_API_TOKEN=
