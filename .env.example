# Lodgify Public API key (Settings > Public API).
# Copy this file to .env and .dev.vars (Wrangler local). Never commit the real key.
# Production: npx wrangler secret put LODGIFY_API_KEY
LODGIFY_API_KEY=

# Stripe (same account Lodgify uses). Secret and webhook signing secret only — never in Angular.
# Production: npx wrangler secret put STRIPE_SECRET_KEY
# Production: npx wrangler secret put STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare API token for Wrangler (account auth, not a Worker binding).
CLOUDFLARE_API_TOKEN=
