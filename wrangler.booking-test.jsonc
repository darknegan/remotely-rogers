{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remotely-rogers-booking-test",
  "main": "workers/booking-calendar/src/index.ts",
  "compatibility_date": "2026-08-07",
  // Nonproduction read-only profile: no routes, KV, DO, migrations, or webhook secrets.
  // Checkout/status/webhook writes stay disabled via BOOKINGMOOD_BOOKING_ENABLED=false.
  "vars": {
    "BOOKINGMOOD_BOOKING_ENABLED": "false",
    "AIRBNB_LISTING_MAP": "{\"1\":\"1522512039110168394\",\"2\":\"1547465342213988673\",\"3\":\"1515997598220048670\",\"4\":\"1511108076176473313\",\"5\":\"1509551118415599833\",\"6\":\"1497757944361518833\"}"
  },
  "assets": {
    "directory": "./dist/remotely-rogers/browser",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
